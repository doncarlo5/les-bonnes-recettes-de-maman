    "en": {
      "title": "Banana Bread",
      "author": "Mary McHale",
      "description": "Moist banana bread made with very ripe bananas.",
      "yieldLabel": "1 loaf",
      "prepTime": "20 min",
      "cookTime": "45 to 60 min",
      "restTime": "",
      "totalTime": "1 h 05 to 1 h 20",
      "timeLabel": "1 h 05 to 1 h 20",
      "temperature": "175 °C",
      "equipment": [
        "1 loaf pan"
      ],
      "ingredients": [
        {
          "name": "white sugar",
          "quantity": "150",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-0"
        },
        {
          "name": "butter",
          "quantity": "115",
          "unit": "g",
          "notes": "softened",
          "id": "ingredient-main-1"
        },
        {
          "name": "very ripe bananas",
          "quantity": "325 to 350",
          "unit": "g",
          "notes": "mashed, about 3 to 4 bananas depending on their size",
          "id": "ingredient-main-2"
        },
        {
          "name": "eggs",
          "quantity": "2",
          "unit": "",
          "notes": "well beaten",
          "id": "ingredient-main-3"
        },
        {
          "name": "T45 flour",
          "quantity": "150",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-4"
        },
        {
          "name": "baking soda",
          "quantity": "1",
          "unit": "tsp",
          "notes": "",
          "id": "ingredient-main-5"
        },
        {
          "name": "salt",
          "quantity": "3",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-6"
        },
        {
          "name": "chopped pecans",
          "quantity": "40",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-7"
        },
        {
          "name": "cinnamon",
          "quantity": "1",
          "unit": "pinch",
          "notes": "",
          "id": "ingredient-main-8"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Preheat the oven to 175 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Beat the softened butter and sugar until light and fluffy.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Add the mashed bananas and beaten eggs, then mix until smooth.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "In another bowl, combine the T45 flour, baking soda and salt. Sift the dry ingredients, ideally several times, then fold them into the banana mixture without overmixing.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Fold the chopped pecans and pinch of cinnamon into the batter.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            }
          ]
        },
        {
          "title": "Baking",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Pour the batter into 1 lightly greased loaf pan.",
              "ingredientUses": []
            },
            {
              "id": "step-1-1",
              "text": "Bake for 45 to 60 min, until the center is firm and a knife or toothpick inserted into it comes out clean or almost clean.",
              "ingredientUses": []
            },
            {
              "id": "step-1-2",
              "text": "Let cool in the pan for 10 min, then unmold onto a rack.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Storage",
          "steps": [
            {
              "id": "step-2-0",
              "text": "This banana bread freezes very well.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            }
          ]
        },
        {
          "title": "Crunchy Pecan Topping (Optional)",
          "steps": [
            {
              "id": "step-3-0",
              "text": "Mix 60 g chopped pecans, 2 tbsp dark brown sugar and 1/2 tsp cinnamon.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-3-1",
              "text": "Pour half the batter into the pan and sprinkle with some of the pecan mixture.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-3-2",
              "text": "Add the remaining batter, sprinkle the rest of the pecan mixture on top and press it in lightly.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            }
          ]
        }
      ],
