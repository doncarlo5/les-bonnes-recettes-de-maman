      "sections": [
        {
          "title": "Préparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Préchauffer le four à 175 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Battre le beurre ramolli avec le sucre jusqu’à obtenir un mélange clair, léger et mousseux.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Ajouter les bananes écrasées et les œufs battus, puis mélanger jusqu’à obtenir une pâte homogène.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Dans un autre saladier, mélanger la farine T45, le bicarbonate de soude et le sel. Tamiser idéalement les ingrédients secs plusieurs fois, puis les incorporer à la préparation à la banane sans trop travailler la pâte.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Incorporer les noix de pécan hachées et la pincée de cannelle à la pâte.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            }
          ]
        },
        {
          "title": "Cuisson",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Verser la pâte dans 1 moule à cake légèrement graissé.",
              "ingredientUses": []
            },
            {
              "id": "step-1-1",
              "text": "Cuire 45 à 60 min, jusqu’à ce que le centre soit ferme et qu’une lame de couteau ou un cure-dent ressorte propre ou presque propre.",
              "ingredientUses": []
            },
            {
              "id": "step-1-2",
              "text": "Laisser refroidir 10 min dans le moule, puis démouler sur une grille.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Conservation",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Ce banana bread se congèle très bien.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Garniture croustillante aux noix (facultative)",
          "steps": [
            {
              "id": "step-3-0",
              "text": "Mélanger 60 g de noix de pécan hachées, 2 c. à s. de cassonade foncée et 1/2 c. à café de cannelle.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-3-1",
              "text": "Verser la moitié de la pâte dans le moule et parsemer une partie du mélange aux noix.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-3-2",
              "text": "Ajouter le reste de pâte, parsemer le reste du mélange sur le dessus et presser légèrement.",
              "ingredientUses": []
            }
          ]
        }
