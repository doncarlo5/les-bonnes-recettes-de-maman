        },
        {
          "name": "icing sugar",
          "quantity": "50",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-3"
        },
        {
          "name": "thick crème fraîche",
          "quantity": "200",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-4"
        },
        {
          "name": "vanilla extract",
          "quantity": "1",
          "unit": "tsp",
          "notes": "",
          "id": "ingredient-main-5"
        },
        {
          "name": "meringues",
          "quantity": "2",
          "unit": "large",
          "notes": "",
          "id": "ingredient-main-6"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Oil the ring mold.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Beat the egg yolks and granulated sugar vigorously until the mixture turns pale.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Add the vanilla extract and cream.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Whip the egg whites, adding the icing sugar at the end.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Gently fold the whites into the mixture and pour half into the mold.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Add the roughly crushed meringues, then finish with the remaining mixture.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Freeze for 3 h.",
              "ingredientUses": []
            },
            {
              "id": "step-0-7",
              "text": "To unmold, dip the mold in warm water for a few seconds.",
              "ingredientUses": []
            }
