          "steps": [
            {
              "id": "step-0-0",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ],
              "text": "Heat the oven to 180 °C. Drain the pineapple and reserve the syrup."
            },
            {
              "id": "step-0-1",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                },
                {
                  "ingredientId": "ingredient-main-0"
                }
              ],
              "text": "Heat the caramel sugar and water in a saucepan until amber. Pour into the tin and arrange the pineapple rings on top. A hob-safe tin can also be used to make the caramel directly."
            },
            {
              "id": "step-0-2",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
