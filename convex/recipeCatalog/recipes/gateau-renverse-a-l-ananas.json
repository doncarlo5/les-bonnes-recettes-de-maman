                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-4"
                }
              ],
              "text": "Whisk the eggs with the 100 g sugar and vanilla sugar. Mix in the oil, then the flour and baking powder, until smooth."
            },
            {
              "id": "step-0-3",
              "ingredientUses": [],
              "text": "Pour over the fruit. Bake for about 30 minutes; extend baking if a knife inserted into the cake comes out with raw batter."
            },
            {
              "id": "step-0-4",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ],
              "text": "Loosen the edges and invert onto a heatproof plate. Wait a few minutes before lifting the tin. Optionally drizzle with a little reserved syrup without soaking the cake. Leave to cool."
            }
          ],
          "title": "Preparation"
        }
      ],
