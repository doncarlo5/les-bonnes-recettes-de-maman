      "title": "Nestlé Sweetened Condensed Milk Flan",
      "author": "Maman",
      "description": "Sweetened condensed milk flan baked in a water bath with caramel.",
      "yieldLabel": "6 people",
      "servings": {
        "quantity": 6,
        "unit": "people"
      },
      "prepTime": "",
      "cookTime": "30 to 45 min",
      "restTime": "",
      "totalTime": "",
      "timeLabel": "30 to 45 min",
      "temperature": "170 °C",
      "equipment": [
        "1 loaf pan",
        "1 roasting dish for the water bath"
      ],
      "ingredients": [
        {
          "name": "sweetened condensed milk",
          "quantity": "1",
          "unit": "can",
          "notes": "397 g",
          "id": "ingredient-main-0"
        },
        {
          "name": "eggs",
          "quantity": "3",
          "unit": "",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "whole milk",
          "quantity": "1 1/3",
          "unit": "can",
          "notes": "measured with the empty can",
          "id": "ingredient-main-2"
        },
        {
          "name": "sugar",
          "quantity": "80",
          "unit": "g",
          "notes": "for the caramel",
          "id": "ingredient-main-3"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Crack the eggs.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Add the can of Nestlé sweetened condensed milk.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Using the empty can, measure 1 and 1/3 cans of whole milk.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Blend the mixture with an immersion blender for 5 min.",
              "ingredientUses": []
            },
            {
              "id": "step-0-4",
              "text": "Coat the loaf pan with caramel.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Pour the mixture in gently.",
              "ingredientUses": []
            },
            {
              "id": "step-0-6",
              "text": "Place in a water bath in a 170 °C preheated oven for 30 to 45 min.",
              "ingredientUses": []
            },
            {
              "id": "step-0-7",
              "text": "The flan is done when the knife blade comes out dry.",
              "ingredientUses": []
            },
            {
              "id": "step-0-8",
              "text": "Let cool, refrigerate, and unmold when ready to serve.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Baking Notes",
          "steps": [
            {
              "id": "step-1-0",
              "text": "The water bath should be boiling when the flan goes in.",
              "ingredientUses": []
            },
            {
              "id": "step-1-1",
              "text": "Make the caramel in a pan without water.",
              "ingredientUses": []
            },
            {
              "id": "step-1-2",
              "text": "Do not stir.",
              "ingredientUses": []
            }
          ]
