    "en": {
      "title": "Chocolate Chip Cookies with Fleur de Sel",
      "author": "Julien",
      "description": "Large chocolate chip cookies with crisp edges, soft centers and a touch of fleur de sel.",
      "yieldLabel": "About 20 large cookies",
      "prepTime": "≈ 40 min",
      "cookTime": "10 min",
      "restTime": "30 min in the refrigerator",
      "totalTime": "≈ 1 h 20",
      "timeLabel": "≈ 1 h 20",
      "temperature": "180 °C",
      "equipment": [
        "1 saucepan",
        "2 bowls, 1 of them large",
        "1 wooden spoon",
        "plastic wrap",
        "1 baking sheet",
        "1 wire rack"
      ],
      "ingredients": [
        {
          "name": "butter",
          "quantity": "200",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-0"
        },
        {
          "name": "brown sugar",
          "quantity": "270",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "granulated sugar",
          "quantity": "80",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-2"
        },
        {
          "name": "flour",
          "quantity": "350",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-3"
        },
        {
          "name": "baking soda",
          "quantity": "1",
          "unit": "tsp",
          "notes": "optional",
          "id": "ingredient-main-4"
        },
        {
          "name": "baking powder",
          "quantity": "1",
          "unit": "tsp",
          "notes": "",
          "id": "ingredient-main-5"
        },
        {
          "name": "salt",
          "quantity": "1/2",
          "unit": "tsp",
          "notes": "",
          "id": "ingredient-main-6"
        },
        {
          "name": "large egg",
          "quantity": "1",
          "unit": "",
          "notes": "",
          "id": "ingredient-main-7"
        },
        {
          "name": "vanilla bean",
          "quantity": "1/4",
          "unit": "",
          "notes": "seeds only",
          "id": "ingredient-main-8"
        },
        {
          "name": "dark chocolate",
          "quantity": "200",
          "unit": "g",
          "notes": "roughly chopped",
          "id": "ingredient-main-9"
        },
        {
          "name": "fleur de sel",
          "quantity": "",
          "unit": "",
          "notes": "for sprinkling",
          "id": "ingredient-main-10"
        }
      ],
      "sections": [
        {
          "title": "Preparing the Dough",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Melt the butter in a saucepan over medium heat, then let it cool slightly off the heat.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "While the butter melts, combine the flour, baking soda, baking powder and salt in a first bowl. Roughly chop the chocolate.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Pour the melted butter into a second, larger bowl. Add the brown sugar and granulated sugar, then mix until smooth.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Mix the egg and vanilla seeds into the large bowl until smooth and glossy.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Add the contents of the first bowl to the large bowl in two batches, mixing with a wooden spoon only until the flour is incorporated.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Add the chopped chocolate and mix once more without overworking the dough.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            }
          ]
        },
        {
          "title": "Resting",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Cover the bowl and chill the dough for 30 min.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Baking",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Preheat the oven to 180 °C and line a baking sheet with parchment paper.",
              "ingredientUses": []
            },
            {
              "id": "step-2-1",
              "text": "Shape the dough into large balls with an ice cream scoop or tablespoon, spacing them well apart on the baking sheet.",
              "ingredientUses": []
            },
            {
              "id": "step-2-2",
              "text": "Sprinkle each ball with a small pinch of fleur de sel.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-10"
                }
              ]
            },
            {
              "id": "step-2-3",
              "text": "Bake for 8 min, remove the baking sheet and tap it lightly on the counter to help the cookies spread.",
              "ingredientUses": []
            },
            {
              "id": "step-2-4",
              "text": "Bake for another 2 min, then tap the baking sheet again after removing it from the oven.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Cooling",
          "steps": [
            {
              "id": "step-3-0",
              "text": "Transfer the cookies to a rack and let them rest for at least 10 min before storing or serving.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": []
    }
