      "sections": [
        {
          "title": "Préparation de la pâte",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Faire fondre le beurre dans une casserole à feu moyen, puis le laisser tiédir hors du feu.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Pendant que le beurre fond, mélanger dans un premier bol la farine, le bicarbonate, la levure chimique et le sel. Hacher grossièrement le chocolat.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Verser le beurre fondu dans un second bol, plus grand. Ajouter le sucre roux et le sucre en poudre, puis mélanger jusqu’à obtenir une préparation homogène.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Incorporer l’œuf et les graines de vanille dans le grand bol jusqu’à obtenir une texture lisse et brillante.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Verser le contenu du premier bol dans le grand bol en deux fois, en mélangeant à la cuillère en bois juste assez pour incorporer la farine.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Ajouter le chocolat haché et mélanger une dernière fois sans trop travailler la pâte.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            }
          ]
        },
        {
          "title": "Repos",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Couvrir le bol et placer la pâte au réfrigérateur pendant 30 min.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Cuisson",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Préchauffer le four à 180 °C et recouvrir une plaque de papier cuisson.",
              "ingredientUses": []
            },
            {
              "id": "step-2-1",
              "text": "Former de grosses boules de pâte avec une cuillère à glace ou une cuillère à soupe, puis les espacer largement sur la plaque.",
              "ingredientUses": []
            },
            {
              "id": "step-2-2",
              "text": "Saupoudrer chaque boule d’une petite pincée de fleur de sel.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-10"
                }
              ]
            },
            {
              "id": "step-2-3",
              "text": "Enfourner pour 8 min, sortir la plaque et la taper légèrement sur le plan de travail pour aider les cookies à s’étaler.",
              "ingredientUses": []
            },
            {
              "id": "step-2-4",
              "text": "Poursuivre la cuisson 2 min, puis taper de nouveau la plaque à la sortie du four.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Refroidissement",
          "steps": [
            {
              "id": "step-3-0",
              "text": "Déposer les cookies sur une grille et les laisser reposer au moins 10 min avant de les conserver ou de les déguster.",
              "ingredientUses": []
            }
          ]
        }
