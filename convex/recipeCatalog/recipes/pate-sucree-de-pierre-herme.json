      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Place the softened butter in a mixing bowl.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Add the icing sugar and mix vigorously with a wooden spoon until smooth.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Add the lightly beaten egg, pinch of salt, almond flour and sifted flour.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Mix roughly with the wooden spoon.",
              "ingredientUses": []
            },
            {
              "id": "step-0-4",
              "text": "Place the dough on the work surface.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "With the palm of your hand, smear the dough lightly until homogeneous.",
              "ingredientUses": []
            },
            {
              "id": "step-0-6",
              "text": "Form a ball.",
              "ingredientUses": []
            },
            {
              "id": "step-0-7",
              "text": "Place the ball between 2 sheets of parchment paper and roll it out to 3 to 4 mm thick.",
              "ingredientUses": []
            },
            {
              "id": "step-0-8",
              "text": "Refrigerate for 2 to 3 h, ideally overnight.",
              "ingredientUses": []
            }
          ]
        }
      ],
