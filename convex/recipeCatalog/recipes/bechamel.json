    "en": {
      "title": "Béchamel",
      "author": "Marmiton",
      "description": "Smooth béchamel sauce made with butter, flour and milk and seasoned with nutmeg, cooked in a saucepan or as a quick microwave version.",
      "yieldLabel": "About 600 ml",
      "prepTime": "",
      "cookTime": "15 min",
      "restTime": "",
      "totalTime": "15 min",
      "timeLabel": "15 min",
      "temperature": "",
      "equipment": [
        "1 heavy-bottomed saucepan",
        "1 wooden spoon",
        "1 whisk"
      ],
      "ingredients": [
        {
          "name": "butter",
          "quantity": "50",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-0"
        },
        {
          "name": "flour",
          "quantity": "50",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "milk",
          "quantity": "60",
          "unit": "cl",
          "notes": "",
          "id": "ingredient-main-2"
        },
        {
          "name": "salt",
          "quantity": "",
          "unit": "",
          "notes": "to taste",
          "id": "ingredient-main-3"
        },
        {
          "name": "pepper",
          "quantity": "",
          "unit": "",
          "notes": "to taste",
          "id": "ingredient-main-4"
        },
        {
          "name": "grated nutmeg",
          "quantity": "",
          "unit": "",
          "notes": "to taste",
          "id": "ingredient-main-5"
        }
      ],
      "sections": [
        {
          "title": "In a saucepan",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Melt the butter in a heavy-bottomed saucepan.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Add the flour and stir with a wooden spoon, without letting it brown, until the mixture thickens.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Pour in the milk little by little, stirring constantly, until the sauce thickens.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Season with salt, pepper and grated nutmeg.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            }
          ]
        },
        {
          "title": "Quick microwave version",
          "steps": [
            {
              "id": "step-1-0",
              "text": "In a large bowl, melt the butter in the microwave for 1 min, then add the flour and stir well.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-1-1",
              "text": "Bring the milk to the boil and let it boil for a few moments.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-1-2",
              "text": "Pour the milk over the butter and flour mixture while whisking, then season.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            },
            {
              "id": "step-1-3",
              "text": "Microwave for 1 more min, then whisk well. Continue in 30-second bursts if the sauce is not thick enough.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": [
        "Add more or less milk depending on the consistency you want. For lasagna, a fairly runny béchamel works best.",
        "The milk can be replaced with vegetable stock."
      ]
