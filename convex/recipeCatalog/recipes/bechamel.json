      "sections": [
        {
          "title": "À la casserole",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Faire fondre le beurre dans une casserole à fond épais.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Ajouter la farine et remuer avec une cuillère en bois, sans laisser colorer, jusqu’à ce que le mélange épaississe.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Verser le lait petit à petit sans cesser de remuer, jusqu’à ce que la sauce épaississe.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Assaisonner de sel, de poivre et de muscade râpée.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            }
          ]
        },
        {
          "title": "Version express au micro-ondes",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Dans un grand récipient, faire fondre le beurre 1 min au micro-ondes, puis ajouter la farine en remuant bien.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-1-1",
              "text": "Porter le lait à ébullition et le laisser bouillir quelques instants.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-1-2",
              "text": "Verser le lait sur le mélange beurre-farine en fouettant, puis assaisonner.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            },
            {
              "id": "step-1-3",
              "text": "Remettre 1 min au micro-ondes, puis bien fouetter. Prolonger par tranches de 30 s si la sauce n’est pas assez épaisse.",
              "ingredientUses": []
            }
          ]
        }
      ],
