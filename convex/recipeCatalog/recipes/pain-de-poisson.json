          "steps": [
            {
              "id": "step-0-0",
              "text": "Prepare a loaf pan with parchment paper on the bottom.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Poach the frozen fish mix in prepared court-bouillon for about 10 to 15 min, then drain well.",
