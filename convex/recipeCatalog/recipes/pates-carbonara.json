      "sections": [
        {
          "title": "Préparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Faire cuire les pâtes dans une grande casserole d’eau bouillante salée selon les indications du paquet.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Pendant ce temps, faire dorer les lardons fumés dans une poêle.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Dans un bol, battre les œufs entiers avec le parmesan et du poivre. Saler très légèrement, car les lardons fumés et le parmesan le sont déjà.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Avant d’égoutter les pâtes, réserver un verre d’eau de cuisson. Égoutter les pâtes sans les assécher, puis les remettre dans la casserole chaude hors du feu.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Ajouter aussitôt les lardons, puis verser le mélange aux œufs et au parmesan. Remuer sans arrêt afin que la chaleur résiduelle nappe les pâtes sans brouiller les œufs.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-5",
              "text": "Si la sauce est trop sèche, ajouter un peu d’eau de cuisson réservée. Servir immédiatement avec un peu de parmesan et de poivre.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            }
          ]
        }
