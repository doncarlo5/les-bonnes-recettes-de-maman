                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Effectuer un premier tour simple : replier un tiers de la pâte vers le centre, puis rabattre l’autre tiers par-dessus.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Étaler de nouveau la pâte, puis effectuer une seconde fois le même pliage en trois.",
              "ingredientUses": []
            },
            {
              "id": "step-0-6",
              "text": "Laisser reposer 15 min avant utilisation.",
              "ingredientUses": []
