      "sections": [
        {
          "title": "Préparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Mettre la farine sur le plan de travail.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Réserver 70 g de margarine. Mettre le reste de la margarine en morceaux dans un puits formé au centre de la farine, puis ajouter le sel.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Malaxer en ajoutant progressivement l’eau, jusqu’à obtenir une pâte homogène.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Étaler la pâte au rouleau, puis répartir les 70 g de margarine réservés sur toute la surface.",
