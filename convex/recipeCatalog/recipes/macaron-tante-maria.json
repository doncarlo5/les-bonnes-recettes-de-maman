                },
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            }
          ]
        },
        {
          "title": "Cuisson",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Cuire à four doux, 140 °C, pendant 45 min.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Crème anglaise à la vanille",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Fendre la gousse de vanille et gratter les graines.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-2-1",
              "text": "Faire bouillir 50 cl de lait avec la gousse, les graines de vanille et 1 c. à café très rase de Maïzena.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-8"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-2-2",
              "text": "Mélanger 6 jaunes d’œufs avec 100 g de sucre fin.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-2-3",
              "text": "Retirer la gousse, puis verser progressivement le lait bouillant sur les jaunes en remuant.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-2-4",
              "text": "Remettre dans la casserole et faire épaissir la crème 1 à 2 min à feu doux, sans la laisser bouillir.",
              "ingredientUses": []
            },
            {
              "id": "step-2-5",
              "text": "Laisser refroidir et servir la crème anglaise bien fraîche à côté du macaron.",
              "ingredientUses": []
            }
          ]
        }
      ],
