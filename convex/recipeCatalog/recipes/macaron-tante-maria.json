    "en": {
      "title": "Aunt Maria's Macaron Cake",
      "author": "Tante Maria",
      "description": "Macaron-style almond cake made with egg whites and bitter almond extract, served with vanilla custard.",
      "yieldLabel": "8 people",
      "servings": {
        "quantity": 8,
        "unit": "people"
      },
      "prepTime": "",
      "cookTime": "45 min",
      "restTime": "",
      "totalTime": "",
      "timeLabel": "45 min",
      "temperature": "140 °C",
      "equipment": [
        "1 electric mixer",
        "1 saucepan"
      ],
      "ingredients": [
        {
          "name": "egg whites",
          "quantity": "6",
          "unit": "",
          "notes": "",
          "id": "ingredient-main-0"
        },
        {
          "name": "caster sugar",
          "quantity": "340",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "almonds",
          "quantity": "340",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-2"
        },
        {
          "name": "baking powder",
          "quantity": "1",
          "unit": "pinch",
          "notes": "",
          "id": "ingredient-main-3"
        },
        {
          "name": "bitter almond extract",
          "quantity": "1",
          "unit": "tsp",
          "notes": "",
          "id": "ingredient-main-4"
        },
        {
          "name": "egg yolks",
          "quantity": "6",
          "unit": "",
          "notes": "for the custard, using the yolks left from the macaron cake",
          "id": "ingredient-main-5"
        },
        {
          "name": "milk",
          "quantity": "50",
          "unit": "cl",
          "notes": "for the custard",
          "id": "ingredient-main-6"
        },
        {
          "name": "caster sugar",
          "quantity": "100",
          "unit": "g",
          "notes": "for the custard",
          "id": "ingredient-main-7"
        },
        {
          "name": "cornstarch",
          "quantity": "1",
          "unit": "very level tsp",
          "notes": "for the custard",
          "id": "ingredient-main-8"
        },
        {
          "name": "vanilla bean",
          "quantity": "1",
          "unit": "",
          "notes": "for the custard; if unavailable, use vanilla extract according to the bottle directions",
          "id": "ingredient-main-9"
        }
      ],
      "sections": [
        {
          "title": "Macaron Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Preheat the oven to 140 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Whip the egg whites until very stiff.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Beat with the sugar for 5 min using an electric mixer.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Then add the almonds, baking powder and bitter almond extract.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            }
          ]
        },
        {
          "title": "Baking",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Bake in a low oven at 140 °C for 45 min.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Vanilla Custard",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Split the vanilla bean and scrape out the seeds.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-2-1",
              "text": "Bring 50 cl milk to a boil with the vanilla pod, seeds and 1 very level tsp cornstarch.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-8"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-2-2",
              "text": "Mix 6 egg yolks with 100 g caster sugar.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-2-3",
              "text": "Remove the vanilla pod, then gradually pour the hot milk over the yolks while stirring.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-2-4",
              "text": "Return to the saucepan and thicken over low heat for 1 to 2 min without letting it boil.",
              "ingredientUses": []
            },
            {
              "id": "step-2-5",
              "text": "Let the custard cool, chill it well and serve it alongside the macaron cake.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": [
        "Coffee variation: replace the vanilla with 2 tsp coffee extract, added off the heat."
      ]
    }
  }
}
