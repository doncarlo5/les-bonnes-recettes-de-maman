      "sections": [
        {
          "title": "Préparation du macaron",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Préchauffer le four à 140 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Battre les blancs en neige très ferme.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Tourner avec le sucre 5 min au batteur électrique.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Ajouter ensuite les amandes, la levure et l’extrait d’amande amère.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                },
                {
