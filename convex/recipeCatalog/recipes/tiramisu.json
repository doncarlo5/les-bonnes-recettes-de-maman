      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Make the coffee.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Whip the egg whites and add the icing sugar.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Beat the yolks with the caster sugar.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Add the mascarpone to the sweetened yolks. Mix at speed 1 for no more than 30 seconds, just until the mixture starts to come together. Finish with a spatula, gently pressing any remaining pieces of mascarpone against the sides of the bowl without overworking the mixture.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Fold the whites into the yolks and mascarpone.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-5",
              "text": "Mix the coffee with the tablespoon of alcohol.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Quickly dip each biscuit into the coffee and alcohol mixture, one side and then the other, without letting it become soggy. Place it in the dish immediately.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-7",
              "text": "Arrange the biscuits side by side and press them down lightly to form an even layer.",
              "ingredientUses": []
            },
            {
              "id": "step-0-8",
              "text": "Add the mixture.",
              "ingredientUses": []
            },
            {
              "id": "step-0-9",
              "text": "Dust with cocoa powder.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            }
          ]
        },
        {
          "title": "Resting",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Refrigerate for 10 to 12 h.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": [
        "Be careful not to overmix the mascarpone, as it should not become too runny."
