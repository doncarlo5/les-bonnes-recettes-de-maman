    "en": {
      "title": "Apricot Clafoutis",
      "author": "Maman",
      "description": "Soft, lightly browned apricot clafoutis made with almond flour.",
      "yieldLabel": "6 people",
      "prepTime": "",
      "cookTime": "35 to 40 min",
      "restTime": "",
      "totalTime": "",
      "timeLabel": "35 to 40 min",
      "temperature": "180 °C",
      "equipment": [
        "1 baking dish or 1 24 cm round pan"
      ],
      "ingredients": [
        {
          "name": "apricots",
          "quantity": "500 to 600",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-0"
        },
        {
          "name": "eggs",
          "quantity": "3",
          "unit": "",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "sugar",
          "quantity": "80",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-2"
        },
        {
          "name": "flour",
          "quantity": "60",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-3"
        },
        {
          "name": "almond flour",
          "quantity": "40",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-4"
        },
        {
          "name": "semi-skimmed milk",
          "quantity": "250",
          "unit": "ml",
          "notes": "",
          "id": "ingredient-main-5"
        },
        {
          "name": "vanilla extract",
          "quantity": "1",
          "unit": "tsp",
          "notes": "or the seeds from half a vanilla bean",
          "id": "ingredient-main-6"
        },
        {
          "name": "salt",
          "quantity": "1",
          "unit": "pinch",
          "notes": "",
          "id": "ingredient-main-7"
        },
        {
          "name": "butter",
          "quantity": "20",
          "unit": "g",
          "notes": "for the pan, or use a little oil",
          "id": "ingredient-main-8"
        },
        {
          "name": "brown sugar",
          "quantity": "1",
          "unit": "tbsp",
          "notes": "optional, to lightly caramelize the top",
          "id": "ingredient-main-9"
        },
        {
          "name": "sliced almonds",
          "quantity": "a few",
          "unit": "",
          "notes": "optional",
          "id": "ingredient-main-10"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Preheat the oven to 180 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Butter a baking dish or a pan about 24 cm in diameter.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Wash the apricots, halve and pit them. Arrange them in the dish, cut side up.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Whisk the eggs with the sugar until evenly combined.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Add the flour, almond flour and pinch of salt.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-5",
              "text": "Gradually pour in the milk while whisking until the batter is smooth, then add the vanilla.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Pour the batter over the apricots.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            }
          ]
        },
        {
          "title": "Optional Finishing",
          "steps": [
            {
              "id": "step-1-0",
              "text": "For a lightly caramelized top, sprinkle with brown sugar and, if desired, a few sliced almonds.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                },
                {
                  "ingredientId": "ingredient-main-10"
                }
              ]
            }
          ]
        },
        {
          "title": "Baking",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Bake for 35 to 40 min, until the top is golden brown and the center is just set.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            }
          ]
        },
        {
          "title": "Serving",
          "steps": [
            {
              "id": "step-3-0",
              "text": "Let cool for 15 to 20 min before serving. The clafoutis is excellent warm or chilled for a few hours in the refrigerator.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": [
        "If the apricots are a little tart, sprinkle them with one tablespoon of sugar before pouring in the batter. This balances their flavor without making the clafoutis too sweet."
      ]
    }
  }
}
