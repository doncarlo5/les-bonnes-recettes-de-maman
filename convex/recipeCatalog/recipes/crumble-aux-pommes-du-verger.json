    "en": {
      "title": "Orchard Apple Crumble",
      "author": "Maman",
      "description": "Apple crumble with brown sugar, almond flour, cinnamon and calvados.",
      "yieldLabel": "4 to 6 people",
      "prepTime": "15 min",
      "cookTime": "35 min",
      "restTime": "",
      "totalTime": "",
      "timeLabel": "35 min",
      "temperature": "180 °C",
      "equipment": [
        "1 baking dish"
      ],
      "ingredients": [
        {
          "name": "apples",
          "quantity": "1,2",
          "unit": "kg",
          "notes": "",
          "id": "ingredient-main-0"
        },
        {
          "name": "semi-wholemeal flour",
          "quantity": "100",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "salted butter, at room temperature",
          "quantity": "100",
          "unit": "g",
          "notes": "cut into small cubes",
          "id": "ingredient-main-2"
        },
        {
          "name": "butter",
          "quantity": "20",
          "unit": "g",
          "notes": "for the dish",
          "id": "ingredient-main-3"
        },
        {
          "name": "brown sugar",
          "quantity": "120",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-4"
        },
        {
          "name": "almond flour",
          "quantity": "50",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-5"
        },
        {
          "name": "ground cinnamon",
          "quantity": "1",
          "unit": "tsp",
          "notes": "",
          "id": "ingredient-main-6"
        },
        {
          "name": "calvados",
          "quantity": "4",
          "unit": "tbsp",
          "notes": "",
          "id": "ingredient-main-7"
        },
        {
          "name": "salt",
          "quantity": "1",
          "unit": "pinch",
          "notes": "",
          "id": "ingredient-main-8"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Preheat the oven to 180 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Peel the apples and cut them into small pieces.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Place the apples in the buttered baking dish and drizzle with calvados.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "In a large bowl, mix the flour, almond flour, cinnamon, brown sugar and butter.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Add the pinch of salt. Stir gently.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Cover the apples with the flour-almond-butter-brown sugar mixture and bake for about 35 min. After 30 min of baking, if the apples are not completely tender, continue baking, covering the crumble with parchment paper.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                }
              ]
            },
            {
              "id": "step-0-7",
              "text": "Serve the crumble warm or cold.",
              "ingredientUses": []
            }
          ]
        }
