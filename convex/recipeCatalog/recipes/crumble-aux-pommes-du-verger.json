      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Preheat the oven to 180 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-1",
              "text": "Peel the apples, quarter them, remove the core and seeds, then cut into thick slices.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Place them in a deep plate and drizzle with calvados.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "In a large bowl, mix the flour, almond flour, cinnamon, brown sugar and butter.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Add the pinch of salt. Stir gently.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-5",
              "text": "Butter the dish and arrange the calvados-flavored apple slices.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            },
            {
              "id": "step-0-6",
