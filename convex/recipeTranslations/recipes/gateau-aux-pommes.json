        "ingredient-main-1": { "name": "suiker", "quantity": "8", "unit": "el", "notes": "" },
        "ingredient-main-2": { "name": "melk", "quantity": "6", "unit": "el", "notes": "" },
        "ingredient-main-3": { "name": "olie", "quantity": "4", "unit": "el", "notes": "" },
        "ingredient-main-4": { "name": "appelen", "quantity": "4", "unit": "flinke", "notes": "" },
        "ingredient-main-5": { "name": "ei", "quantity": "2", "unit": "", "notes": "" },
        "ingredient-main-6": { "name": "zout", "quantity": "2", "unit": "snufjes", "notes": "" },
        "ingredient-main-7": { "name": "bakpoeder", "quantity": "1", "unit": "zakje", "notes": "" },
        "ingredient-main-8": { "name": "boter", "quantity": "80", "unit": "g", "notes": "crème" },
        "ingredient-main-9": { "name": "suiker", "quantity": "100", "unit": "g", "notes": "crème" },
        "ingredient-main-10": { "name": "ei", "quantity": "1", "unit": "", "notes": "crème" },
        "ingredient-main-11": { "name": "vanille", "quantity": "", "unit": "", "notes": "crème" }
      },
      "sections": [
        {
          "title": "Bereiding",
          "steps": {
            "step-0-0": "Verwarm de oven voor op 180 °C.",
            "step-0-1": "Meng de bloem, de suiker, het bakpoeder en het zout.",
            "step-0-2": "Voeg de melk, de eieren en de olie toe.",
            "step-0-3": "Werk alles goed door elkaar.",
            "step-0-4": "Giet het beslag in een ronde taartvorm, bekleed met schijfjes appel.",
            "step-0-5": "Bak 25 min in de oven op 180 °C."
          }
        },
        {
          "title": "Crème",
          "steps": {
            "step-1-0": "Smelt de boter in een kookpot.",
            "step-1-1": "Voeg de suiker, het ei en de vanille toe."
          }
        },
        {
          "title": "Verder bakken",
          "steps": {
            "step-2-0": "Na 25 min, wanneer de taart begint te rijzen en goudbruin te kleuren, giet je de crème over de taart en bak je nog 15 min verder."
          }
        },
        {
          "title": "Bewaren",
          "steps": {
            "step-3-0": "Deze taart blijft 3 à 4 dagen goed."
