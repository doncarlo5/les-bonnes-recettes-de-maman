      "sections": [
        {
          "title": "Preparo",
          "steps": {
            "step-0-0": "Preaqueça o forno a 180 °C.",
            "step-0-1": "Misture a farinha, o açúcar, o fermento e o sal.",
            "step-0-2": "Junte o leite, os ovos e o óleo.",
            "step-0-3": "Trabalhe bem a massa.",
            "step-0-4": "Despeje em uma forma redonda forrada com fatias de maçã.",
            "step-0-5": "Leve ao forno a 180 °C por 25 min."
          }
        },
        {
          "title": "Creme",
          "steps": {
            "step-1-0": "Derreta a manteiga em uma panela.",
            "step-1-1": "Junte o açúcar, o ovo e a baunilha."
          }
        },
        {
          "title": "Final do cozimento",
          "steps": {
            "step-2-0": "Depois de 25 min, quando o bolo começar a crescer e dourar, despeje o creme sobre o bolo e continue assando por mais 15 min."
          }
        },
        {
          "title": "Conservação",
          "steps": {
            "step-3-0": "Este bolo se conserva por 3 a 4 dias."
          }
        }
